# Postgres, used by the postgres container and referenced by the api container
POSTGRES_USER=tesla_pool
POSTGRES_PASSWORD=change_me
POSTGRES_DB=dhaka_tesla_pool

# Backend
# Inside Docker this points at the postgres service name, not localhost.
DATABASE_URL=postgresql://tesla_pool:change_me@postgres:5432/dhaka_tesla_pool
JWT_SECRET=change_me_too
JWT_EXPIRES_IN=1d
PORT=3001

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
